# ---------------------------------------------------------------------------
# ModelForge backend configuration
# Copy this file to ".env" and adjust values as needed.
# ---------------------------------------------------------------------------

# SQLite by default. Swap for a PostgreSQL URL later, e.g.:
# DATABASE_URL=postgresql://user:password@localhost:5432/modelforge
DATABASE_URL=sqlite:///./modelforge.db

# Directory (relative to backend/) where uploaded model artifacts are stored.
MODEL_STORAGE_DIR=./storage/models

# Maximum allowed upload size, in megabytes.
MAX_UPLOAD_SIZE_MB=50

# Comma-separated list of allowed model file extensions.
ALLOWED_MODEL_EXTENSIONS=.joblib

# Allowed origins for CORS (comma-separated). Used so the Vite dev server
# can talk to the API during local development.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# API metadata
API_TITLE=ModelForge API
API_VERSION=0.1.0

# Replica & Scaling configuration
MAX_REPLICAS=5
DEFAULT_REPLICAS=1

# Monitoring & Alerting thresholds
ALERT_LATENCY_THRESHOLD_MS=500.0
ALERT_ERROR_RATE_THRESHOLD_PERCENT=5.0
MONITORING_RETENTION_DAYS=30

# Docker & Containerized Deployment (Phase 6)
DOCKER_ENABLED=false
DOCKER_NETWORK=modelforge-network
INFERENCE_IMAGE=modelforge-inference:latest
CONTAINER_HEALTHCHECK_TIMEOUT_SEC=5.0
# Named volume or host path mounted into replica containers (defaults to MODEL_STORAGE_DIR path):
# MODEL_STORAGE_MOUNT=modelforge-models
CONTAINER_PORT_START=8100
