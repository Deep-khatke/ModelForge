# ---------------------------------------------------------------------------
# ModelForge Frontend Configuration
# Copy this file to ".env" and adjust values as needed.
# ---------------------------------------------------------------------------

# Base URL of the ModelForge backend API
VITE_API_BASE_URL=http://localhost:8000

# ---------------------------------------------------------------------------
# Firebase Web Client Configuration (Phase 8.5)
# Obtained from: Firebase Console -> Project Settings -> General -> Your apps -> Web app
# These are public client configuration values (safe in client bundle).
# ---------------------------------------------------------------------------
VITE_FIREBASE_API_KEY=your-api-key-here
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
VITE_FIREBASE_APP_ID=your-app-id-here
