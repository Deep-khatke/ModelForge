# ---------------------------------------------------------------------------
# ModelForge backend configuration
# Copy this file to ".env" and adjust values as needed.
# ---------------------------------------------------------------------------

# Database backend selection: "sqlite" (default) or "firestore"
DATABASE_BACKEND=sqlite

# SQLite by default. Swap for a PostgreSQL URL later, e.g.:
# DATABASE_URL=postgresql://user:password@localhost:5432/modelforge
DATABASE_URL=sqlite:///./modelforge.db

# ---------------------------------------------------------------------------
# Firebase Configuration (Phase 8.5)
# ---------------------------------------------------------------------------
# Your Google Cloud / Firebase Project ID:
FIREBASE_PROJECT_ID=your-firebase-project-id

# Local path to your private Firebase service account key JSON file:
# Obtained from: Firebase Console -> Project Settings -> Service accounts -> Generate new private key
# Store locally in backend/ (e.g. backend/firebase-credentials.json) which is in .gitignore.
# Never commit this JSON file!
GOOGLE_APPLICATION_CREDENTIALS=./firebase-credentials.json

# Toggle Firebase Authentication verification (set to true when Firebase Auth is active):
FIREBASE_AUTH_ENABLED=false

# ---------------------------------------------------------------------------
# Model Artifact Storage
# ---------------------------------------------------------------------------
# Directory (relative to backend/) where uploaded model artifacts are stored.
MODEL_STORAGE_DIR=./storage/models

# Maximum allowed upload size, in megabytes.
MAX_UPLOAD_SIZE_MB=50

# Comma-separated list of allowed model file extensions.
ALLOWED_MODEL_EXTENSIONS=.joblib

# Allowed origins for CORS (comma-separated).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# API metadata
API_TITLE=ModelForge API
API_VERSION=0.1.0

# Replica & Scaling configuration
MAX_REPLICAS=5
DEFAULT_REPLICAS=1

# Monitoring & Alerting thresholds
ALERT_LATENCY_THRESHOLD_MS=500.0
ALERT_ERROR_RATE_THRESHOLD_PERCENT=5.0
MONITORING_RETENTION_DAYS=30

# Docker & Containerized Deployment (Phase 6)
DOCKER_ENABLED=false
DOCKER_NETWORK=modelforge-network
INFERENCE_IMAGE=modelforge-inference:latest
CONTAINER_HEALTHCHECK_TIMEOUT_SEC=5.0
# MODEL_STORAGE_MOUNT=modelforge-models
CONTAINER_PORT_START=8100

# Authentication & RBAC (Phase 8 local fallback)
AUTH_ENABLED=true
JWT_SECRET_KEY=modelforge-secret-key-32-chars-minimum-token-protection
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
ALLOW_PUBLIC_REGISTRATION=false
INITIAL_ADMIN_EMAIL=admin@modelforge.local
INITIAL_ADMIN_PASSWORD=AdminPassword123!
INITIAL_ADMIN_NAME=ModelForge Administrator
